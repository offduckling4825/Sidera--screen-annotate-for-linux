post_install() {
  # 重载 udev 规则并触发 input 子系统，使 uaccess 生效
  udevadm control --reload-rules 2>/dev/null || true
  udevadm trigger --subsystem-match=input 2>/dev/null || true
  modprobe uinput 2>/dev/null || true
  echo ">>> Sidera: 触摸权限已配置。若刚安装，请重新登录（或重新插拔触摸屏）后再用触屏批注。"
}

post_upgrade() {
  post_install
}

post_remove() {
  udevadm control --reload-rules 2>/dev/null || true
}
